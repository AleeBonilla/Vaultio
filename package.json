{
  "name": "vaultio",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace @vaultio/api",
    "dev:web": "npm run dev --workspace @vaultio/web",
    "start:api": "npm run start --workspace @vaultio/api",
    "build:api": "npm run build --workspace @vaultio/api",
    "build:web": "npm run build --workspace @vaultio/web",
    "test:api": "npm run test --workspace @vaultio/api",
    "typecheck:web": "npm run typecheck --workspace @vaultio/web",
    "test": "npm run test:api",
    "build": "npm run build:api && npm run build:web",
    "prisma:generate": "npm run prisma:generate --workspace @vaultio/api"
  }
}
