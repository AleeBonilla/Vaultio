# Firebase Web SDK config: copia este archivo a `.env.local` y reemplaza los valores.
# Firebase Console -> Project Settings -> General -> Tus apps -> Configuración del SDK.
# En Vercel, configura estas variables en Project Settings -> Environment Variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# URL del API local. En Vercel debe apuntar al backend público.
VITE_API_URL=http://localhost:4000
