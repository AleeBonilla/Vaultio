VITE_API_URL=http://localhost:4000
VAULTIO_API_PORT=4000
VAULTIO_API_PUBLIC_URL=http://localhost:4000
VAULTIO_CORS_ORIGINS=http://localhost:5173,http://localhost:4173
VAULTIO_DATA_FILE=apps/api/data/db.json
VAULTIO_FIREBASE_SERVICE_ACCOUNT=secrets/vaultio-auth-service-account.json

# Storage local MinIO. Para Cloudflare R2, ver README.
VAULTIO_STORAGE_PROVIDER=minio
VAULTIO_STORAGE_BUCKET=vaultio-demo
VAULTIO_STORAGE_REGION=us-east-1
VAULTIO_STORAGE_ENDPOINT=http://localhost:9000
VAULTIO_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
VAULTIO_STORAGE_ACCESS_KEY_ID=vaultio
VAULTIO_STORAGE_SECRET_ACCESS_KEY=vaultio-demo-secret
VAULTIO_STORAGE_FORCE_PATH_STYLE=true
VAULTIO_STORAGE_PUBLIC_INCLUDE_BUCKET=true
VAULTIO_STORAGE_AUTO_CREATE_BUCKET=true
